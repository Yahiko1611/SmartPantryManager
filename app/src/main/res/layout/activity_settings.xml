<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/green_mist">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
        android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingTop="22dp" android:paddingBottom="14dp">
        <TextView android:text="PERSONALISE YOUR PANTRY" android:textSize="12sp" android:textStyle="bold" android:letterSpacing="0.1"
            android:textColor="@color/green_primary" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <TextView android:text="Settings" android:textSize="26sp" android:textStyle="bold" android:textColor="@color/text_primary"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" />
        <TextView android:text="Preferences are saved on this device." android:textSize="14sp" android:textColor="@color/text_secondary"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" />
    </LinearLayout>
    <include layout="@layout/bottom_navigation" />
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
            android:padding="18dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
                android:padding="18dp" android:background="@drawable/bg_card">
                <TextView android:text="Expiry reminders" android:textSize="18sp" android:textStyle="bold" android:textColor="@color/text_primary"
                    android:layout_width="match_parent" android:layout_height="wrap_content" />
                <TextView android:text="Show a pantry reminder when an item expires within the next three days. Items with no expiry date are ignored."
                    android:textSize="14sp" android:textColor="@color/text_secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" />
                <androidx.appcompat.widget.SwitchCompat android:id="@+id/switch_expiry_alerts" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Enable expiring-soon alerts" android:textSize="14sp" android:layout_marginTop="15dp" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
                android:padding="18dp" android:background="@drawable/bg_card" android:layout_marginTop="12dp">
                <TextView android:text="Default quantity unit" android:textSize="18sp" android:textStyle="bold" android:textColor="@color/text_primary"
                    android:layout_width="match_parent" android:layout_height="wrap_content" />
                <TextView android:text="Preselect this unit when adding a new ingredient. You can still change it for each item."
                    android:textSize="14sp" android:textColor="@color/text_secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" />
                <Spinner android:id="@+id/spinner_default_unit" android:layout_width="match_parent" android:layout_height="52dp"
                    android:layout_marginTop="12dp" android:paddingStart="8dp" android:background="@drawable/bg_spinner" />
            </LinearLayout>
            <Button android:id="@+id/btn_save_settings" android:layout_width="match_parent" android:layout_height="50dp"
                android:text="Save preferences" android:textAllCaps="false" android:textStyle="bold" android:textColor="@color/white"
                android:background="@drawable/bg_button" android:backgroundTint="@null" android:layout_marginTop="18dp" />
            <TextView android:text="About Smart Pantry Manager" android:textSize="17sp" android:textStyle="bold" android:textColor="@color/text_primary"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" />
            <TextView android:text="A local-first Java Android app designed to help households use leftover ingredients. Recipe suggestions are strict: every listed ingredient and required amount must be available. This app does not use GPS, maps, payments or a shopping-store locator."
                android:textSize="14sp" android:textColor="@color/text_secondary" android:lineSpacingExtra="4dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
