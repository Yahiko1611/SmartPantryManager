<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/green_mist">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
        android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingTop="22dp" android:paddingBottom="14dp">
        <TextView android:text="PANTRY MANAGEMENT" android:textSize="12sp" android:textStyle="bold" android:letterSpacing="0.12"
            android:textColor="@color/green_primary" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <TextView android:id="@+id/txt_form_title" android:text="Add an ingredient" android:textSize="26sp" android:textStyle="bold"
            android:textColor="@color/text_primary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" />
        <TextView android:text="Record the amount you currently have. Recipe suggestions use the quantity as well as the ingredient name."
            android:textSize="14sp" android:textColor="@color/text_secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" />
    </LinearLayout>
    <include layout="@layout/bottom_navigation" />
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
            android:layout_margin="18dp" android:padding="20dp" android:background="@drawable/bg_card">
            <TextView android:text="Ingredient name" android:textSize="14sp" android:textStyle="bold" android:textColor="@color/text_primary"
                android:layout_width="match_parent" android:layout_height="wrap_content" />
            <EditText android:id="@+id/input_ingredient_name" android:layout_width="match_parent" android:layout_height="52dp"
                android:hint="e.g. tomatoes" android:singleLine="true" android:inputType="textCapWords" android:paddingStart="12dp"
                android:paddingEnd="12dp" android:layout_marginTop="7dp" android:background="@drawable/bg_nav" />
            <TextView android:text="Quantity" android:textSize="14sp" android:textStyle="bold" android:textColor="@color/text_primary"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" />
            <EditText android:id="@+id/input_ingredient_quantity" android:layout_width="match_parent" android:layout_height="52dp"
                android:hint="e.g. 250" android:singleLine="true" android:inputType="numberDecimal|numberSigned" android:paddingStart="12dp"
                android:paddingEnd="12dp" android:layout_marginTop="7dp" android:background="@drawable/bg_nav" />
            <TextView android:text="Unit" android:textSize="14sp" android:textStyle="bold" android:textColor="@color/text_primary"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" />
            <Spinner android:id="@+id/spinner_ingredient_unit" android:layout_width="match_parent" android:layout_height="52dp"
                android:layout_marginTop="7dp" android:paddingStart="8dp" android:background="@drawable/bg_spinner" />
            <TextView android:text="Expiry date (optional)" android:textSize="14sp" android:textStyle="bold" android:textColor="@color/text_primary"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:orientation="horizontal" android:gravity="center_vertical"
                android:layout_marginTop="7dp" android:background="@drawable/bg_nav">
                <EditText android:id="@+id/input_expiry_date" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
                    android:hint="YYYY-MM-DD" android:singleLine="true" android:inputType="date" android:paddingStart="12dp" android:paddingEnd="5dp"
                    android:background="@android:color/transparent" />
                <Button android:id="@+id/btn_pick_expiry" android:layout_width="wrap_content" android:layout_height="42dp" android:text="Choose"
                    android:textAllCaps="false" android:textColor="@color/green_primary" android:background="@drawable/bg_button_secondary"
                    android:backgroundTint="@null" android:minHeight="0dp" android:layout_marginEnd="5dp" />
            </LinearLayout>
            <TextView android:text="Use grams for solids and millilitres for liquids when possible. Compatible units such as kg/g and L/ml are converted for matching."
                android:textSize="12sp" android:textColor="@color/text_secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" />
            <Button android:id="@+id/btn_save_ingredient" android:layout_width="match_parent" android:layout_height="50dp" android:text="Save ingredient"
                android:textAllCaps="false" android:textStyle="bold" android:textColor="@color/white" android:background="@drawable/bg_button"
                android:backgroundTint="@null" android:layout_marginTop="22dp" />
            <Button android:id="@+id/btn_cancel_ingredient" android:layout_width="match_parent" android:layout_height="48dp" android:text="Cancel"
                android:textAllCaps="false" android:textColor="@color/green_primary" android:background="@drawable/bg_button_secondary"
                android:backgroundTint="@null" android:layout_marginTop="8dp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
