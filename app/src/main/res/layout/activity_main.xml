<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/green_mist">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingStart="20dp" android:paddingEnd="20dp"
        android:paddingTop="22dp" android:paddingBottom="14dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="SMART PANTRY" android:textSize="12sp" android:textStyle="bold" android:letterSpacing="0.13"
            android:textColor="@color/green_primary" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Make the most of what you have." android:textSize="25sp" android:textStyle="bold"
            android:textColor="@color/text_primary" android:layout_marginTop="5dp" />
        <TextView android:id="@+id/txt_pantry_subtitle" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Keep track of your ingredients and waste less food." android:textSize="14sp"
            android:textColor="@color/text_secondary" android:layout_marginTop="5dp" />
    </LinearLayout>
    <include layout="@layout/bottom_navigation" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
        android:paddingStart="18dp" android:paddingEnd="18dp" android:paddingTop="12dp" android:paddingBottom="6dp">
        <TextView android:id="@+id/txt_expiry_banner" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:visibility="gone" android:padding="14dp" android:background="@drawable/bg_amber"
            android:textColor="@color/amber_text" android:textSize="13sp" android:layout_marginBottom="10dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
            android:background="@drawable/bg_soft" android:padding="16dp" android:gravity="center_vertical">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:text="YOUR PANTRY" android:textStyle="bold" android:textSize="11sp" android:letterSpacing="0.08"
                    android:textColor="@color/green_primary" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:id="@+id/txt_item_count" android:text="0 ingredients saved" android:textStyle="bold"
                    android:textSize="20sp" android:textColor="@color/text_primary" android:layout_marginTop="5dp"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>
            <TextView android:text="Less waste.\nMore meals." android:textSize="13sp" android:textColor="@color/green_dark"
                android:gravity="end" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
            android:gravity="center_vertical" android:layout_marginTop="18dp" android:layout_marginBottom="10dp">
            <TextView android:text="Pantry ingredients" android:textSize="18sp" android:textStyle="bold" android:textColor="@color/text_primary"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" />
            <Button android:id="@+id/btn_add_ingredient" android:layout_width="wrap_content" android:layout_height="44dp"
                android:text="+ Add item" android:textAllCaps="false" android:textStyle="bold" android:textColor="@color/white"
                android:background="@drawable/bg_button" android:minHeight="0dp" android:paddingStart="16dp" android:paddingEnd="16dp" android:backgroundTint="@null" />
        </LinearLayout>
    </LinearLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:paddingStart="18dp" android:paddingEnd="18dp" android:paddingBottom="10dp">
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/recycler_pantry" android:layout_width="match_parent"
            android:layout_height="match_parent" android:clipToPadding="false" android:paddingBottom="8dp" />
        <LinearLayout android:id="@+id/empty_pantry" android:layout_width="match_parent" android:layout_height="match_parent"
            android:orientation="vertical" android:gravity="center" android:padding="28dp" android:visibility="gone">
            <TextView android:text="Your pantry is ready for a fresh start" android:textSize="18sp" android:textStyle="bold"
                android:textColor="@color/text_primary" android:gravity="center" android:layout_width="match_parent" android:layout_height="wrap_content" />
            <TextView android:text="Add the ingredients you already have at home. We will only suggest recipes you can make with enough of every ingredient."
                android:textSize="14sp" android:textColor="@color/text_secondary" android:gravity="center" android:layout_marginTop="9dp"
                android:layout_width="match_parent" android:layout_height="wrap_content" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
